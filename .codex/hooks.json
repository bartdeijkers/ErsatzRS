{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-hooks/guard_test_runner.py\"",
            "timeout": 30,
            "statusMessage": "Enforcing the repository test runner"
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-hooks/guard_contributing_contract.py\"",
            "timeout": 30,
            "statusMessage": "Checking repository content contract"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-hooks/rustfmt_single_file.py\"",
            "timeout": 30,
            "statusMessage": "Formatting edited Rust file"
          }
        ]
      }
    ]
  }
}
