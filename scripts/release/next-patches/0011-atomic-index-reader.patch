+fn preserve_indexed_playout_owner(base: &Value, overlay: &Value) -> Result<(), ChannelError> {
+    if base.pointer("/playout/layout").and_then(Value::as_str)
+        != Some(ersatztv_playout::indexed::VERSION)
+    {
+        return Ok(());
+    }
+    if let Some(playout) = overlay.get("playout") {
+        let changed = !playout.is_object()
+            || ["layout", "folder"].into_iter().any(|field| {
+                playout.get(field).is_some_and(|value| {
+                    base.get("playout").and_then(|owner| owner.get(field)) != Some(value)
+                })
+            });
+        if changed {
+            return Err(ChannelError::ChannelConfigFailure(String::from(
+                "indexed playout ownership cannot be changed by an overlay",
+            )));
+        }
+    }
+    Ok(())
+}
