+#[test]
+fn atomic_replacement_and_exclusive_reclamation_keep_reader_snapshots_complete() {
+    use std::sync::{
+        Arc, Barrier,
+        atomic::{AtomicUsize, Ordering},
+    };
+    let folder = folder();
+    let path = folder.path();
+    // Use nanoseconds for generation identity without moving the next slot out
+    // of its civil-day reference.
+    let generation = |number: i64| {
+        let a = day(path, 0, 10, vec![item(&number.to_string(), 0, 5)]);
+        let mut b = item("lookahead", 12, 13);
+        b.start += Duration::nanoseconds(number);
+        vec![a, day(path, 10, 30, vec![b])]
+    };
+    let initial = generation(0);
+    let mut previous: Vec<_> = initial.iter().map(|d| d.file.clone()).collect();
+    publish(path, initial);
+    let barrier = Arc::new(Barrier::new(2));
+    let ready = barrier.clone();
+    let successes = AtomicUsize::new(0);
+    std::thread::scope(|scope| {
+        let reader = scope.spawn(|| {
+            ready.wait();
+            for _ in 0..1000 {
+                match select(path, at(1)) {
+                    Ok(snapshot) => {
+                        let current = snapshot.current.unwrap();
+                        let number = current
+                            .valid_items()
+                            .next()
+                            .unwrap()
+                            .id
+                            .parse::<i64>()
+                            .unwrap();
+                        assert_eq!(
+                            snapshot.next_start,
+                            Some(at(12) + Duration::nanoseconds(number))
+                        );
+                        successes.fetch_add(1, Ordering::Relaxed);
+                    }
+                    Err(IndexError::Busy) => std::thread::yield_now(),
+                    other => panic!("reader lost a published snapshot: {other:?}"),
+                }
+            }
+        });
+        barrier.wait();
+        for number in 1..101 {
+            let days = generation(number);
+            let current = days.iter().map(|d| d.file.clone()).collect();
+            let bytes = serde_json::to_vec(&Index {
+                version: VERSION.into(),
+                days,
+            })
+            .unwrap();
+            let mut staged = tempfile::NamedTempFile::new_in(path).unwrap();
+            std::io::Write::write_all(&mut staged, &bytes).unwrap();
+            staged.persist(path.join("index.json")).unwrap();
+            let lease = OpenOptions::new()
+                .read(true)
+                .write(true)
+                .open(path.join(".index-readers.lock"))
+                .unwrap();
+            let deadline = std::time::Instant::now() + std::time::Duration::from_secs(5);
+            while let Err(error) = lease.try_lock() {
+                assert!(matches!(error, TryLockError::WouldBlock));
+                assert!(std::time::Instant::now() < deadline);
+                std::thread::yield_now();
+            }
+            for old in previous {
+                std::fs::remove_file(path.join(old)).unwrap();
+            }
+            previous = current;
+        }
+        reader.join().unwrap();
+    });
+    assert!(successes.load(Ordering::Relaxed) > 0);
+}
