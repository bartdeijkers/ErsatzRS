+// Unix symlink creation needs no privileges; native Windows held-handle/reparse
+// qualification remains a required separate platform proof.
+#[cfg(unix)]
+#[test]
+fn refuses_symlinks_for_index_chunk_and_reader_lease() {
+    use std::os::unix::fs::symlink;
+    for target in ["index.json", ".index-readers.lock", "chunk"] {
+        let folder = folder();
+        let path = folder.path();
+        let d = day(path, 0, 10, vec![]);
+        let name = if target == "chunk" {
+            d.file.clone()
+        } else {
+            target.into()
+        };
+        publish(path, vec![d]);
+        std::fs::rename(path.join(&name), path.join("unrelated")).unwrap();
+        symlink(path.join("unrelated"), path.join(name)).unwrap();
+        assert!(select(path, at(1)).is_err());
+        assert!(path.join("unrelated").is_file());
+    }
+}
