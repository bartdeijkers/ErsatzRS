+use std::path::Path;
+
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use time::OffsetDateTime;
+
+use crate::playout::{self, PlayoutLoadResult};
+
+pub const VERSION: &str = "ersatzrs.playout-index.v1";
+const MAX_DAYS: usize = 366;
+const MAX_INDEX_BYTES: usize = 128 * 1024;
+const MAX_DAY_BYTES: usize = 32 * 1024 * 1024;
+const MAX_TOTAL_BYTES: usize = 256 * 1024 * 1024;
+
+#[derive(Debug, thiserror::Error, PartialEq, Eq)]
+pub enum IndexError {
+    #[error("indexed playout is busy; retry selection")]
+    Busy,
+    #[error("indexed playout is unavailable")]
+    Unavailable,
+    #[error("indexed playout contract or content is invalid")]
+    Invalid,
+}
+
+#[derive(Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Index {
+    pub version: String,
+    pub days: Vec<Day>,
+}
+
+#[derive(Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Day {
+    #[serde(with = "time::serde::rfc3339")]
+    pub start: OffsetDateTime,
+    #[serde(with = "time::serde::rfc3339")]
+    pub finish: OffsetDateTime,
+    pub file: String,
+    pub sha256: String,
+}
+
+/// One snapshot's selected document and earliest later slot, including invalid slots.
+pub struct Selection {
+    pub current: Option<PlayoutLoadResult>,
+    pub next_start: Option<OffsetDateTime>,
+    pub identity: String,
+}
+
+impl std::fmt::Debug for Selection {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("Selection")
+            .field("has_current", &self.current.is_some())
+            .field("next_start", &self.next_start)
+            .field("identity", &self.identity)
+            .finish()
+    }
+}
+
+fn digest(bytes: &[u8]) -> String {
+    Sha256::digest(bytes)
+        .iter()
+        .map(|b| format!("{b:02x}"))
+        .collect()
+}
+
+impl Index {
+    pub fn validate(&self) -> Result<(), IndexError> {
+        if self.version != VERSION || self.days.len() > MAX_DAYS {
+            return Err(IndexError::Invalid);
+        }
+        for day in &self.days {
+            if day.start >= day.finish
+                || day.sha256.len() != 64
+                || !day
+                    .sha256
+                    .bytes()
+                    .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+                || day.file != format!("day-{}.json", day.sha256)
+            {
+                return Err(IndexError::Invalid);
+            }
+        }
+        if self.days.windows(2).any(|w| w[0].finish > w[1].start) {
+            return Err(IndexError::Invalid);
+        }
+        Ok(())
+    }
+}
+
+/// Read one generation under the same shared lease that fences publisher reclamation.
+/// No retry or sleep occurs here: Busy returns to the worker's bounded selection loop.
+pub fn select(folder: &Path, now: OffsetDateTime) -> Result<Selection, IndexError> {
+    let folder = folder.canonicalize().map_err(|_| IndexError::Unavailable)?;
+    let lease = regular_file(&folder.join(".index-readers.lock"), true)?;
+    match lease.try_lock_shared() {
+        Ok(()) => {}
+        Err(TryLockError::WouldBlock) => return Err(IndexError::Busy),
+        Err(TryLockError::Error(_)) => return Err(IndexError::Unavailable),
+    }
+    // Keep the handle alive through every chunk open/read, not just index parsing.
+    let result = select_locked(&folder, now);
+    drop(lease);
+    result
+}
+
+fn select_locked(folder: &Path, now: OffsetDateTime) -> Result<Selection, IndexError> {
+    let bytes = bounded_read(&folder.join("index.json"), MAX_INDEX_BYTES)?;
+    let index: Index = serde_json::from_slice(&bytes).map_err(|_| IndexError::Invalid)?;
+    index.validate()?;
+    let mut declared_total = 0u64;
+    for day in &index.days {
+        let meta = std::fs::symlink_metadata(folder.join(&day.file))
+            .map_err(|_| IndexError::Unavailable)?;
+        if !meta.is_file() || meta.is_symlink() || meta.len() > MAX_DAY_BYTES as u64 {
+            return Err(IndexError::Invalid);
+        }
+        declared_total = declared_total
+            .checked_add(meta.len())
+            .ok_or(IndexError::Invalid)?;
+        if declared_total > MAX_TOTAL_BYTES as u64 {
+            return Err(IndexError::Invalid);
+        }
+    }
+    let mut result = Selection {
+        current: None,
+        next_start: None,
+        identity: digest(&bytes),
+    };
+    let mut total = 0usize;
+    for day in index.days.iter().filter(|day| now < day.finish) {
+        let bytes = bounded_read(&folder.join(&day.file), MAX_DAY_BYTES)?;
+        total = total.checked_add(bytes.len()).ok_or(IndexError::Invalid)?;
+        if total > MAX_TOTAL_BYTES || digest(&bytes) != day.sha256 {
+            return Err(IndexError::Invalid);
+        }
+        let text = std::str::from_utf8(&bytes).map_err(|_| IndexError::Invalid)?;
+        let playout = playout::from_str(text).map_err(|_| IndexError::Invalid)?;
+        let later = playout
+            .items
+            .iter()
+            .map(|item| item.start())
+            .filter(|start| *start > now)
+            .min();
+        result.next_start = result.next_start.into_iter().chain(later).min();
+        if day.start <= now {
+            result.current = Some(playout);
+        }
+        // A matching chunk with a later slot, or the first later day with a slot,
+        // completes lookahead without reading every future document on each tick.
+        if result.next_start.is_some() {
+            break;
+        }
+    }
+    Ok(result)
+}
+
+fn bounded_read(path: &Path, limit: usize) -> Result<Vec<u8>, IndexError> {
+    let file = regular_file(path, false)?;
+    if file.metadata().map_err(|_| IndexError::Unavailable)?.len() > limit as u64 {
+        return Err(IndexError::Invalid);
+    }
+    let mut bytes = Vec::new();
+    file.take(limit as u64 + 1)
+        .read_to_end(&mut bytes)
+        .map_err(|_| IndexError::Unavailable)?;
+    if bytes.len() > limit {
+        return Err(IndexError::Invalid);
+    }
+    Ok(bytes)
+}
+
+fn regular_file(path: &Path, writable: bool) -> Result<File, IndexError> {
+    let mut options = OpenOptions::new();
+    options.read(true).write(writable);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        // Refuse symlinks atomically; nonblocking open also avoids waiting on a FIFO.
+        options.custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK);
+    }
+    #[cfg(windows)]
+    {
+        use std::os::windows::fs::OpenOptionsExt;
+        // Open the reparse point itself and reject it below. Allow the publisher's
+        // same-directory atomic index replacement while this handle is open.
+        options.custom_flags(0x0020_0000).share_mode(7);
+    }
+    let file = options.open(path).map_err(|_| IndexError::Unavailable)?;
+    let meta = file.metadata().map_err(|_| IndexError::Unavailable)?;
+    if !meta.is_file() || meta.is_symlink() {
+        return Err(IndexError::Invalid);
+    }
+    Ok(file)
+}
