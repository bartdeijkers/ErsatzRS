+use super::*;
+use crate::playout::{Playout, PlayoutItem};
+use time::Duration;
+
+fn at(seconds: i64) -> OffsetDateTime {
+    OffsetDateTime::from_unix_timestamp(1_790_000_000 + seconds).unwrap()
+}
+
+fn item(id: &str, start: i64, finish: i64) -> PlayoutItem {
+    PlayoutItem::new(
+        id.into(),
+        at(start),
+        at(finish),
+        None,
+        None,
+        Path::new("item.mkv"),
+    )
+    .unwrap()
+}
+
+fn day(folder: &Path, start: i64, finish: i64, items: Vec<PlayoutItem>) -> Day {
+    let bytes = serde_json::to_vec(&Playout::new(items)).unwrap();
+    let sha256 = digest(&bytes);
+    let file = format!("day-{sha256}.json");
+    std::fs::write(folder.join(&file), bytes).unwrap();
+    Day {
+        start: at(start),
+        finish: at(finish),
+        file,
+        sha256,
+    }
+}
+
+fn publish(folder: &Path, days: Vec<Day>) {
+    let bytes = serde_json::to_vec(&Index {
+        version: VERSION.into(),
+        days,
+    })
+    .unwrap();
+    std::fs::write(folder.join("index.json"), bytes).unwrap();
+}
+
+fn folder() -> tempfile::TempDir {
+    let folder = tempfile::tempdir().unwrap();
+    File::create(folder.path().join(".index-readers.lock")).unwrap();
+    folder
+}
