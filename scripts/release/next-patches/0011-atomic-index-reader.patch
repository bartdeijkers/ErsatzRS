+#[test]
+fn selected_day_retains_fractional_timing_tracks_and_cross_day_identity() {
+    let folder = folder();
+    let path = folder.path();
+    let mut crossing = item("occurrence", 5, 25);
+    crossing.start += Duration::nanoseconds(123_456_700);
+    crossing.tracks = Some(crate::playout::PlayoutItemTracks {
+        audio: Some(crate::playout::TrackSelection {
+            source: None,
+            stream_index: Some(2),
+        }),
+        video: None,
+        subtitle: None,
+    });
+    let bytes = serde_json::to_vec(&crossing).unwrap();
+    let d1 = day(path, 0, 10, vec![serde_json::from_slice(&bytes).unwrap()]);
+    let d2 = day(path, 10, 30, vec![crossing]);
+    publish(path, vec![d1, d2]);
+    for now in [at(6), at(11)] {
+        let selected = select(path, now).unwrap().current.unwrap();
+        assert_eq!(
+            serde_json::to_vec(selected.valid_items().next().unwrap()).unwrap(),
+            bytes
+        );
+    }
+}
+
+#[test]
+fn lookahead_crosses_empty_days_and_stops_at_the_end() {
+    let folder = folder();
+    let path = folder.path();
+    let days = vec![
+        day(path, 0, 10, vec![item("a", 0, 5)]),
+        day(path, 10, 20, vec![]),
+        day(path, 20, 30, vec![item("b", 22, 25)]),
+    ];
+    publish(path, days);
+    for seconds in [6, 15, 21] {
+        assert_eq!(select(path, at(seconds)).unwrap().next_start, Some(at(22)));
+    }
+    assert_eq!(select(path, at(25)).unwrap().next_start, None);
+    assert!(select(path, at(30)).unwrap().current.is_none());
+    publish(path, vec![]);
+    let empty = select(path, at(0)).unwrap();
+    assert!(empty.current.is_none() && empty.next_start.is_none());
+}
+
+#[test]
+fn malformed_missing_or_unsupported_index_never_scans_an_unreferenced_file() {
+    let folder = folder();
+    let path = folder.path();
+    day(path, 0, 10, vec![item("must-not-play", 0, 10)]);
+    for bytes in [
+        b"{".as_slice(),
+        br#"{"version":"unknown","days":[]}"#,
+        br#"{"version":"ersatzrs.playout-index.v1","days":[],"secret":"omitted"}"#,
