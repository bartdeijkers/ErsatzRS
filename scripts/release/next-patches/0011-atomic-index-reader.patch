+#[test]
+fn exclusive_publisher_returns_busy_without_waiting_and_shared_readers_coexist() {
+    let folder = folder();
+    let path = folder.path();
+    publish(path, vec![]);
+    let lease = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(path.join(".index-readers.lock"))
+        .unwrap();
+    lease.try_lock().unwrap();
+    assert_eq!(select(path, at(0)).unwrap_err(), IndexError::Busy);
+    lease.unlock().unwrap();
+    lease.try_lock_shared().unwrap();
+    assert!(select(path, at(0)).is_ok());
