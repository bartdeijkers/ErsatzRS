+        std::fs::write(path.join("index.json"), bytes).unwrap();
+        assert_eq!(select(path, at(1)).unwrap_err(), IndexError::Invalid);
+    }
+    std::fs::remove_file(path.join("index.json")).unwrap();
+    assert_eq!(select(path, at(1)).unwrap_err(), IndexError::Unavailable);
+}
