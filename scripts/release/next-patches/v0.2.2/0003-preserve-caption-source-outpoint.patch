+/// Shift the caption mapping cursor and pass edge with copied AV, retaining
+/// the caption source's original exclusive trim boundary.
+fn copy_subtitle_timing(
+    (start, end): (Duration, Duration),
+    target: Duration,
+    landing: Duration,
+    original_out: Duration,
+) -> Option<(Duration, Duration)> {
+    let shift = |value: Duration| {
+        if landing >= target {
+            value.checked_add(landing - target)
+        } else {
+            Some(value.saturating_sub(target - landing))
+        }
+    };
+    Some((shift(start)?, shift(end)?.min(original_out)))
+}
