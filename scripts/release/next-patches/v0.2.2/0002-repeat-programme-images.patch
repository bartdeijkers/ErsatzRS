+    #[test]
+    fn animated_programme_loops_all_frames_with_input_options_and_output_bound() {
+        for (codec, container, live, http, repeated) in [
+            ("gif", "gif", false, false, true),
+            ("gif", "gif", false, true, true),
+            ("gif", "gif", true, true, false),
+            ("webp_anim", "webp_anim", false, false, true),
+            ("webp_anim", "webp_anim", false, true, true),
+            ("webp_anim", "webp_anim", true, false, false),
+            ("webp_anim", "webp_anim", true, true, false),
+            ("webp_anim", "matroska", false, false, false),
+            ("gif", "matroska", false, false, false),
+            ("webp", "webp_pipe", false, false, false),
+            ("h264", "matroska", false, false, false),
+        ] {
+            let mut input = multichannel_ac3_input("image-input");
+            let crate::probe::ProbeResultStream::Video(stream) =
+                &mut input.video_input.probe_result.streams[0]
+            else {
+                panic!("fixture must have video");
+            };
+            stream.codec = codec.to_owned();
+            input.video_input.probe_result.format_name = Some(container.to_owned());
+            if http {
+                input.video_input.input_source = InputSource::Http(crate::input::HttpInputSource {
+                    uri: "https://media.example.test/animation.gif".to_owned(),
+                    options: crate::input::HttpInputOptions::default(),
+                });
+            }
+            let mut output = stereo_output();
+            output.is_live = live;
+            let mut pipeline = Pipeline::full(&FfmpegInfo::default(), input, output).unwrap();
+            pipeline.optimize();
+            let argv = pipeline.args();
+            let args: Vec<&str> = argv.iter().map(|arg| arg.as_ref()).collect();
+            let loop_pos = args
+                .windows(4)
+                .position(|w| w == ["-ignore_loop", "1", "-stream_loop", "-1"]);
+            assert_eq!(loop_pos.is_some(), repeated, "{codec}/{container}");
+            if let Some(position) = loop_pos {
+                let input_pos = args.iter().position(|arg| *arg == "-i").unwrap();
+                assert!(position < input_pos);
+                assert!(args.windows(2).any(|w| w == ["-t", "30000ms"]));
+                assert!(!args.iter().any(|arg| arg.contains("loop=-1:1")));
+            }
         }
     }
 
