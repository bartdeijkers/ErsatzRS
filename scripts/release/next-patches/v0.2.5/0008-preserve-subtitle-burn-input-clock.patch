+            (
+                Duration::from_millis(2_143),
+                "setpts=PTS+round(2.143/TB),subtitles=captions.srt,setpts=PTS-round(2.143/TB)",
+            ),
+            (
+                Duration::from_millis(12_345),
+                "setpts=PTS+round(12.345/TB),subtitles=captions.srt,setpts=PTS-round(12.345/TB)",
+            ),
+        ] {
