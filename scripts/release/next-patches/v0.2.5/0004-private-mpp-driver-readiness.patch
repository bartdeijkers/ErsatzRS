 impl MppLib {
-    pub fn load() -> Result<Self, libloading::Error> {
-        let name = "librockchip_mpp.so.1";
+    pub fn load() -> Result<Self, Box<dyn std::error::Error + Send + Sync>> {
+        // ADR 0128: only the verified companion beside this packaged worker.
+        // A bare library name could silently select an unpinned system MPP.
+        let executable = std::env::current_exe()?;
+        let directory = executable
+            .parent()
+            .ok_or_else(|| std::io::Error::other("Next executable has no package directory"))?;
+        let name = directory.join("librockchip_mpp.so.1");
+        if !std::fs::symlink_metadata(&name)?.file_type().is_file() {
+            return Err(std::io::Error::other("MPP companion must be a regular file").into());
+        }
         unsafe {
             let lib = Library::new(name)?;
             let mpp_check_support_format = *lib.get(b"mpp_check_support_format\0")?;
+            let mpp_create = *lib.get(b"mpp_create\0")?;
+            let mpp_init = *lib.get(b"mpp_init\0")?;
+            let mpp_destroy = *lib.get(b"mpp_destroy\0")?;
             Ok(Self {
                 _lib: lib,
                 mpp_check_support_format,
+                mpp_create,
+                mpp_init,
+                mpp_destroy,
             })
         }
     }
 
     pub fn is_supported(&self, ctx_type: i32, coding: i32) -> bool {
-        unsafe { (self.mpp_check_support_format)(ctx_type, coding) == MPP_OK }
+        // Compiled codec support alone does not establish driver readiness.
+        // Initialize an owned context for each capability, then always release
+        // it before returning. The worker supervisor bounds a stalled driver.
+        unsafe {
+            if (self.mpp_check_support_format)(ctx_type, coding) != MPP_OK {
+                return false;
+            }
+            let mut context = ptr::null_mut();
+            let mut api = ptr::null_mut();
+            let created = (self.mpp_create)(&mut context, &mut api);
+            if context.is_null() {
+                return false;
+            }
+            let ready = created == MPP_OK
+                && !api.is_null()
+                && (self.mpp_init)(context, ctx_type, coding) == MPP_OK;
+            let released = (self.mpp_destroy)(context);
+            ready && released == MPP_OK
+        }
     }
 }
