 pub struct MppLib {
     _lib: Library,
     mpp_check_support_format: unsafe extern "C" fn(ctx_type: i32, coding: i32) -> i32,
+    mpp_create: unsafe extern "C" fn(*mut *mut c_void, *mut *mut c_void) -> i32,
+    mpp_init: unsafe extern "C" fn(*mut c_void, i32, i32) -> i32,
+    mpp_destroy: unsafe extern "C" fn(*mut c_void) -> i32,
