+//! Software-only companion/fallback checks; these never qualify Rockchip hardware.
+#![cfg(all(target_os = "linux", target_arch = "aarch64"))]
+
+use libmpp_sys::probe::*;
+
+#[test]
+#[ignore = "requires the reviewed private MPP companion and no Rockchip drivers"]
+fn bundled_mpp_without_drivers_advertises_no_hardware() {
+    let library = MppLib::load().expect("reviewed regular companion beside test executable");
+    for context in [MPP_CTX_DEC, MPP_CTX_ENC] {
+        for codec in [
+            MPP_VIDEO_CodingAVC,
+            MPP_VIDEO_CodingHEVC,
+            MPP_VIDEO_CodingVP8,
+            MPP_VIDEO_CodingVP9,
+        ] {
+            assert!(
+                !library.is_supported(context, codec),
+                "compiled codec enumeration must not imply driver readiness: {context}/{codec}"
+            );
+        }
+    }
+}
+
+#[test]
+#[ignore = "requires a missing or symlinked private companion and a library on the system search path"]
+fn missing_or_symlinked_private_companion_never_uses_system_mpp() {
+    assert!(MppLib::load().is_err());
+}
