+    #[test]
+    fn gif_programme_loops_all_frames_with_input_options_and_output_bound() {
+        for (codec, container, repeated) in [
+            ("gif", "gif", true),
+            ("gif", "matroska", false),
+            ("webp", "webp_pipe", false),
+            ("h264", "matroska", false),
+        ] {
+            let mut input = multichannel_ac3_input("image-input");
+            let crate::probe::ProbeResultStream::Video(stream) =
+                &mut input.video_input.probe_result.streams[0]
+            else {
+                panic!("fixture must have video");
+            };
+            stream.codec = codec.to_owned();
+            input.video_input.probe_result.format_name = Some(container.to_owned());
+            let mut pipeline =
+                Pipeline::full(&FfmpegInfo::default(), input, stereo_output()).unwrap();
+            pipeline.optimize();
+            let argv = pipeline.args();
+            let args: Vec<&str> = argv.iter().map(|arg| arg.as_ref()).collect();
+            let loop_pos = args
+                .windows(4)
+                .position(|w| w == ["-ignore_loop", "1", "-stream_loop", "-1"]);
+            assert_eq!(loop_pos.is_some(), repeated, "{codec}/{container}");
+            if let Some(position) = loop_pos {
+                let input_pos = args.iter().position(|arg| *arg == "-i").unwrap();
+                assert!(position < input_pos);
+                assert!(args.windows(2).any(|w| w == ["-t", "30000ms"]));
+                assert!(!args.iter().any(|arg| arg.contains("loop=-1:1")));
+            }
         }
     }
