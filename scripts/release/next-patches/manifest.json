      "file": "0001-bound-live-rtsp-shortest-buffer.patch",
      "sha256": "591244c915ca42ff09b332be731751454c88edd3f84bed304c6a231c0aab2aee",
      "retire_when": "Unpatched upstream passes the existing live RTSP startup and EOF/handoff regressions plus compatibility acceptance. Remove this patch, not the tests.",
      "upstream_review_revision": "54c6cb9ec03b7bd259144896c625c06fda09b3d0",
      "unpatched_regression": "Official released v0.2.3 fails the unchanged actual live HTTP/RTSP source-clock readiness regression (33.601s); source retains the default shortest queue for this path. Existing minimal patch applies cleanly; patched candidate acceptance is pending.",
      "evidence": "docs/progress/milestones.toml (ucu-12)"
    },
    {
      "file": "0002-repeat-programme-images.patch",
      "sha256": "0c4e9cafa2436d2846ae3d306560b29e6c59b85d2d759fc977a3e7c78d873176",
      "retire_when": "Unpatched upstream passes static WebP and complete finite/infinite GIF/WebP seek, repeat, cancellation and schedule-boundary handoff regressions plus compatibility acceptance. Remove this patch, not the tests.",
      "upstream_review_revision": "54c6cb9ec03b7bd259144896c625c06fda09b3d0",
      "unpatched_regression": "Official released v0.2.3 fails unchanged scheduled WebP picture/silent-audio acceptance (1.153s, 52 unexpected bright pixels with subtitles off). Existing minimal patch applies cleanly; patched candidate acceptance is pending.",
      "evidence": "docs/progress/milestones.toml (ucu-12)"
    },
    {
      "file": "0003-update-worker-security-lock.patch",
      "sha256": "50807a9d63a226b9366546e5f6288a18acced7d3ddc52291f38e212430679e13",
      "upstream_review_revision": "54c6cb9ec03b7bd259144896c625c06fda09b3d0",
      "retire_when": "Remove when the adopted unpatched upstream worker passes the same six-target advisory/yanked-crate gate and affected source/runtime acceptance without this patch. Preserve the tests and exact source/lock verification.",
      "unpatched_regression": "Pinned Next0.2.3 worker fails unchanged advisories policy on all six supported targets: Rustls0.23.40, webpki0.103.13, Tokio1.52.1 and yanked ChaCha20.10.0. Current upstream848acba6 retains those versions. Minimal correction updates these four plus Rustls-required aws-lc1.18 backend/build dependencies; unsupported upstream binaries are excluded from the worker graph, not ignored by policy.",
      "evidence": "docs/progress/milestones.toml (ucu-12); worker-audit-before.log and worker-audit-after.log"
    },
    {
      "file": "0004-private-mpp-driver-readiness.patch",
      "sha256": "a8ad711c4ac17283bb027fecf974e8419ad6f6e459a08d695b811bc0224b5712",
      "upstream_review_revision": "54c6cb9ec03b7bd259144896c625c06fda09b3d0",
      "retire_when": "Remove when the adopted upstream privately loads its verified ARM64 MPP companion and passes actual bundled-library/no-device fallback, positive native capability and complete ownership/provenance acceptance without this patch. Retain the tests.",
      "unpatched_regression": "Released Next0.2.3 loads bare librockchip_mpp.so.1 and treats mpp_check_support_format (compiled codec enumeration) as driver readiness. A bundled library would falsely advertise RKMPP on ordinary ARM64 systems; context create/init/destroy and private owned loading are required by accepted ADR0128.",
      "evidence": "docs/progress/milestones.toml (ucu-12); ADR0128"
    },
    {
      "file": "0005-reject-empty-mpp-capabilities.patch",
      "sha256": "9d5603607ca211889efd0ecdf2884eee303b0985323c100fb290179afcfe80b9",
      "upstream_review_revision": "54c6cb9ec03b7bd259144896c625c06fda09b3d0",
      "retire_when": "Remove when unpatched upstream returns whole-channel software fallback for bundled MPP without initialized hardware codecs and passes the same actual scaled Dutch-audio/subtitle playback regression. Preserve the regression.",
      "unpatched_regression": "Actual rs.3 ARM64 worker detects empty MPP codec sets but wraps them as RKMPP hardware, selects scale_rkrga/init_hw_device, and fails the existing no-device Dutch AV/subtitle fixture. Empty capability refusal must reach the existing channel software-fallback path.",
      "evidence": "docs/progress/milestones.toml (ucu-12); rockchip-inputs/channel-fallback/before-with-ca.log"
    }
  ],
