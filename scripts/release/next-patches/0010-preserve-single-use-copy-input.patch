+fn streaming_source_timing(item: &PlayoutItem, now: OffsetDateTime) -> TimingResult {
+    TimingResult {
+        in_point: Duration::ZERO,
+        out_point: Duration::from_millis((item.finish - now).whole_milliseconds().max(0) as u64),
+        finish: item.finish,
+        is_complete: true,
+    }
+}
+
+fn source_single_use(
+    source: &PlayoutItemSource,
+) -> Result<Option<&SingleUseInputHint>, ChannelError> {
+    let Some(hint) = source.probe_hint() else {
+        return Ok(None);
+    };
+    let Some(single_use) = hint.single_use.as_ref() else {
+        return Ok(None);
+    };
+    if single_use.version != 1
+        || !matches!(
+            source,
+            PlayoutItemSource::Http {
+                in_point_ms: None | Some(0),
+                ..
+            }
+        )
+        || single_use.first_video_packets.iter().any(|packet| {
+            hint.video
+                .iter()
+                .filter(|v| v.stream_index == packet.stream_index)
+                .count()
+                != 1
+                || single_use
+                    .first_video_packets
+                    .iter()
+                    .filter(|other| other.stream_index == packet.stream_index)
+                    .count()
+                    != 1
+        })
+    {
+        return Err(ChannelError::ProbeHintFailure);
+    }
+    Ok(Some(single_use))
+}
+
+fn single_use_copy_blocker(hint: &SingleUseInputHint, video_index: u32) -> Option<CopyBlocker> {
+    match hint
+        .first_video_packets
+        .iter()
+        .find(|p| p.stream_index == video_index)
+        .map(|p| p.is_keyframe)
+    {
+        Some(true) => None,
+        Some(false) => Some(CopyBlocker::StartsBetweenKeyframes),
+        None => Some(CopyBlocker::InputStartUnverified),
+    }
+}
