+        } else {
+            let shift = format!("round({}/TB)", self.seek.as_secs_f64());
+            Some(format!(
+                "settb=expr=1/90000,setpts=PTS+{shift},{trim},setpts=PTS-{shift}"
+            ))
+        }
+    }
