+fn selected_source_frame_cut(
+    item: &PlayoutItem,
+    video_source: &PlayoutItemSource,
+    selected_index: u32,
+) -> Result<Option<SourceFrameCut>, ChannelError> {
+    let Some(hint) = video_source.probe_hint() else {
+        return Ok(None);
+    };
+    let mut required = hint
+        .video
+        .iter()
+        .filter(|video| video.source_frame_cut.is_some());
+    let Some(video) = required.next() else {
+        return Ok(None);
+    };
+    if required.next().is_some()
+        || video.stream_index != selected_index
+        || hint
+            .video
+            .iter()
+            .filter(|video| video.stream_index == selected_index)
+            .count()
+            != 1
+    {
+        return Err(FFPipelineError::InvalidSourceFrameCut.into());
+    }
+    let cut = video
+        .source_frame_cut
+        .as_ref()
+        .ok_or(ChannelError::ProbeHintFailure)?;
+    if cut.version != 1 || source_points_ms(item, video_source).1 != cut.out_point_ms {
+        return Err(FFPipelineError::InvalidSourceFrameCut.into());
+    }
+    Ok(Some(SourceFrameCut::new(
+        cut.out_point_ms,
+        cut.first_excluded_pts_90k,
+    )?))
