+    #[test]
+    fn live_rtsp_bounds_shortest_buffer_without_changing_other_sources() {
+        use crate::input::{HttpInputOptions, HttpInputSource, RtspInputOptions, RtspInputSource};
+
+        for (source, live, expected) in [
+            (
+                InputSource::Rtsp(RtspInputSource {
+                    uri: "rtsp://example.test/source".to_owned(),
+                    options: RtspInputOptions::default(),
+                }),
+                true,
+                Some("0.500"),
+            ),
+            (
+                InputSource::Rtsp(RtspInputSource {
+                    uri: "rtsp://example.test/source".to_owned(),
+                    options: RtspInputOptions::default(),
+                }),
+                false,
+                None,
+            ),
+            (
+                InputSource::Local(crate::input::LocalInputSource {
+                    path: "fixture.mkv".to_owned(),
+                }),
+                true,
+                None,
+            ),
+            (
+                InputSource::Http(HttpInputSource {
+                    uri: "https://example.test/source".to_owned(),
+                    options: HttpInputOptions::default(),
+                }),
+                true,
+                None,
+            ),
+        ] {
+            let mut input = multichannel_ac3_input("fixture.mkv");
+            input.video_input.input_source = source.clone();
+            input.audio_input.input_source = source;
+            let mut output = stereo_output();
+            output.is_live = live;
+            let mut pipeline = Pipeline::full(&FfmpegInfo::default(), input, output).unwrap();
+            pipeline.optimize();
+            let args = pipeline.args();
+            assert_eq!(shortest_buf_duration(&args), expected, "{args:?}");
+        }
+    }
+
+    #[test]
+    fn live_rtsp_audio_copy_still_omits_shortest() {
+        use crate::input::{RtspInputOptions, RtspInputSource};
+
+        let mut input = multichannel_ac3_input("fixture.mkv");
+        let source = InputSource::Rtsp(RtspInputSource {
+            uri: "rtsp://example.test/source".to_owned(),
+            options: RtspInputOptions::default(),
+        });
+        input.video_input.input_source = source.clone();
+        input.audio_input.input_source = source;
+        let mut output = stereo_output();
+        output.is_live = true;
+        output.audio.copy = Some(crate::output_settings::CopyPolicy::default());
+        let mut pipeline = Pipeline::full(&FfmpegInfo::default(), input, output).unwrap();
+        pipeline.optimize();
+        let args = pipeline.args();
+        assert!(
+            !args
+                .iter()
+                .any(|arg| arg == "-shortest" || arg == "-shortest_buf_duration"),
+            "{args:?}"
+        );
     }
 
