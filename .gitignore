# Cargo build output
/target/
/debug/

# These are backup files generated by rustfmt
**/*.rs.bk

# Python agent-hook test cache
__pycache__/
*.pyc

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# insta review artifacts; committed snapshots use *.snap
**/*.snap.new

# Local environment and secrets
.env
.env.*
!.env.example
!.env.*.example
config.local.toml
*.local.toml

# Local Claude settings; shared skills and settings.json stay tracked
.claude/settings.local.json

# Runtime databases and sqlx scratch files. Also covers progress.db — the
# derived porting-progress index built by `cargo xtask progress` from the text
# sources in docs/progress/. It is disposable; never commit or force-add it.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# sqlx offline query metadata is generated but must be committed for CI.
!.sqlx/
!.sqlx/*.json

# Logs and runtime output
*.log
/logs/
/tmp/
/temp/
/cache/
/data/
/transcode/
/segments/
/hls/

# Generated frontend/package artifacts
node_modules/
dist/
pkg/
test-results/
# CSS bundle rebuilt by build.rs via stylance-cli
crates/ersatzrs-web/public/bundle.css

# Coverage and profiling output
/coverage/
tarpaulin-report.html
*.profraw
*.profdata
flamegraph.svg

# Git worktrees (local, never committed)
.worktrees/

# Large test fixture videos (download locally, see plans/sequential-dancing-valiant.md)
testdata/

# Derived clippy-exemption snapshot, regenerated from
# xtask/assets/clippy_ledger_template.html by `cargo xtask clippy-ledger`.
# Never commit it — it's a live data view, not a living doc.
docs/reference/clippy-exemption-ledger.html

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
.playwright-mcp/

# Playwright
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Calibration test clips (generated)
/calibration-clips/
