# Cargo build output
/target/
/debug/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# insta review artifacts; committed snapshots use *.snap
**/*.snap.new

# Local environment and secrets
.env
.env.*
!.env.example
!.env.*.example
config.local.toml
*.local.toml

# Local Claude settings; shared skills and settings.json stay tracked
.claude/settings.local.json

# Runtime databases and sqlx scratch files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# Logs and runtime output
*.log
/logs/
/tmp/
/temp/
/cache/
/data/
/transcode/
/segments/
/hls/

# Generated frontend/package artifacts
node_modules/
dist/
pkg/

# Coverage and profiling output
/coverage/
tarpaulin-report.html
*.profraw
*.profdata
flamegraph.svg

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
