* text=auto eol=lf
*.bat text eol=crlf
*.rs diff=rust
*.snap text eol=lf
# Native editor byte fixtures retain CRLF, spacing and teletext control bytes.
crates/ersatzrs-app/src/teletext_tti/fixtures/*.tti -text -diff
Cargo.lock text eol=lf linguist-generated=false
crates/ersatzrs-web/public/vendor/** -whitespace linguist-vendored
# Unified diffs retain blank context markers, including at the end of a hunk.
scripts/release/next-patches/**/*.patch whitespace=-blank-at-eol,-blank-at-eof
