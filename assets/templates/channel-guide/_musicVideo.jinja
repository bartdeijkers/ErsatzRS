{#
  Ports ErsatzTV's `_musicVideo.sbntxt` (Scriban) to minijinja/Jinja2 syntax.
  Available values: programme_start, programme_stop, channel_id,
  channel_number, artist_title, music_video_title, music_video_plot,
  music_video_year, music_video_genres (already union of video + artist
  genres, deduplicated), music_video_artwork_url.
#}
<programme start="{{ programme_start }}" stop="{{ programme_stop }}" channel="{{ channel_id }}">
  {% if has_custom_title %}<title lang="en">{{ custom_title }}</title>{% else %}
    <title lang="en">{{ artist_title }}</title>
    <sub-title lang="en">{{ music_video_title }}</sub-title>
    {% if music_video_has_plot %}<desc lang="en">{{ music_video_plot }}</desc>{% endif %}
    {% if music_video_has_year %}<date>{{ music_video_year }}</date>{% endif %}
    <category lang="en">Music</category>
    {% for genre in music_video_genres %}<category lang="en">{{ genre }}</category>{% endfor %}
    {% for genre in artist_genres %}<category lang="en">{{ genre }}</category>{% endfor %}
    {% if music_video_has_artwork %}<icon src="{{ music_video_artwork_url }}" />{% endif %}
  {% endif %}
  <previously-shown />
</programme>
