---
source: crates/ersatzrs-infra/src/hls_worker.rs
expression: "command.arguments.join(\" \")"
---
-nostdin -hide_banner -nostats -loglevel error -fflags +genpts+discardcorrupt+igndts -i /media/test.mkv -filter_complex [0:1]aresample=async=1,apad[a] -map 0:0 -map [a] -muxdelay 0 -muxpreload 0 -movflags +faststart -flags cgop -bf 0 -sc_threshold 0 -codec:v libx264 -profile:v high -preset:v veryfast -codec:a aac -b:a 192k -maxrate:a 192k -bufsize:a 384k -ar 48k -video_track_timescale 90000 -b:v 8000k -maxrate:v 8000k -bufsize:v 16000k -map_metadata -1 -g 60 -keyint_min 60 -force_key_frames expr:gte(t,n_forced*2) -f hls -hls_time 4 -hls_list_size 0 -segment_list_flags +live -hls_segment_filename seg%05d.ts -hls_segment_type mpegts -hls_flags program_date_time+omit_endlist+append_list+independent_segments live.m3u8
