---
source: crates/ersatzrs-ffmpeg/tests/pipeline_snapshots.rs
expression: args
---
-nostdin -hide_banner -nostats -progress pipe:1 -loglevel error -fflags +genpts+discardcorrupt+igndts -init_hw_device cuda -hwaccel cuda -hwaccel_output_format cuda -i /media/dvd-source.mkv -filter_complex [0:0]hwupload,yadif_cuda,scale_cuda=1920:1080:format=nv12,setsar=1[v];[v]hwdownload,format=nv12,colormatrix=src=bt470bg:dst=bt709,format=yuv420p[vpf];[0:1]aresample=async=1,apad[a] -map [vpf] -map [a] -muxdelay 0 -muxpreload 0 -movflags +faststart -flags cgop -bf 0 -noautoscale -sc_threshold 0 -codec:v h264_nvenc -profile:v high -preset:v veryfast -codec:a aac -b:a 192k -maxrate:a 192k -bufsize:a 384k -ar 48k -r 30000/1001 -vsync cfr -video_track_timescale 90000 -b:v 8000k -maxrate:v 8000k -bufsize:v 16000k -map_metadata -1 -f mpegts -mpegts_flags +initial_discontinuity pipe:1
