---
source: crates/ersatzrs-ffmpeg/tests/pipeline_snapshots.rs
expression: "command.arguments.join(\" \")"
---
-nostdin -hide_banner -nostats -progress pipe:1 -loglevel error -fflags +genpts+discardcorrupt+igndts -hwaccel qsv -hwaccel_output_format qsv -init_hw_device qsv=hw -filter_hw_device hw -i /media/movie.mkv -i /media/movie.mkv -filter_complex [0:0]vpp_qsv=format=nv12[v] -map [v] -map 1:1 -movflags +faststart -flags +cgop -bf 0 -codec:v h264_qsv -profile:v high -low_power 0 -look_ahead 0 -preset:v veryfast -codec:a aac -ac 2 -ar 48000 -b:a 192k -b:v 8000k -bufsize:v 16000k -map_metadata -1 -f mpegts -mpegts_flags +initial_discontinuity pipe:1
