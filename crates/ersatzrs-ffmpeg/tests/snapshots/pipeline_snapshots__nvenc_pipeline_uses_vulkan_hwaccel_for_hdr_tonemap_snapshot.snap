---
source: crates/ersatzrs-ffmpeg/tests/pipeline_snapshots.rs
expression: "command.arguments.join(\" \")"
---
-nostdin -hide_banner -nostats -progress pipe:1 -loglevel error -fflags +genpts+discardcorrupt+igndts -init_hw_device cuda=nv -init_hw_device vulkan=vk@nv -hwaccel vulkan -hwaccel_output_format vulkan -i /media/hdr-movie.mkv -filter_complex [0:0]libplacebo=tonemapping=hable:colorspace=bt709:color_primaries=bt709:color_trc=bt709:format=yuv420p,hwupload_cuda,scale_cuda=format=nv12[v];[0:1]aresample=async=1,apad[a] -map [v] -map [a] -muxdelay 0 -muxpreload 0 -movflags +faststart -flags cgop -bf 0 -noautoscale -sc_threshold 0 -codec:v h264_nvenc -profile:v high -preset:v veryfast -codec:a aac -b:a 192k -bufsize:a 384k -ar 48k -video_track_timescale 90000 -b:v 8000k -bufsize:v 16000k -map_metadata -1 -f mpegts -mpegts_flags +initial_discontinuity pipe:1
