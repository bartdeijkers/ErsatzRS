-nostdin -hide_banner -nostats -progress pipe:1 -loglevel error -fflags +genpts+discardcorrupt+igndts -hwaccel rkmpp -i /media/movie.mkv -map 0:0 -map 0:1 -movflags +faststart -flags +cgop -bf 0 -codec:v h264_rkmpp -profile:v high -pix_fmt yuv420p -codec:a aac -ac 2 -ar 48000 -b:a 192k -b:v 8000k -bufsize:v 16000k -map_metadata -1 -f mpegts -mpegts_flags +initial_discontinuity pipe:1
