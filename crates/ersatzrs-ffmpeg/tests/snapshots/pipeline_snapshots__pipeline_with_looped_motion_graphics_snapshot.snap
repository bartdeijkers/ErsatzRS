---
source: crates/ersatzrs-ffmpeg/tests/pipeline_snapshots.rs
expression: "command.arguments.join(\" \")"
---
-nostdin -hide_banner -nostats -progress pipe:1 -loglevel error -fflags +genpts+discardcorrupt+igndts -c:v h264 -i /media/movie.mkv -stream_loop -1 -i /media/bug.webm -filter_complex [1:0]setpts=PTS+2.5/TB,scale=384:-1[gi0];[0:0][gi0]overlay=x=19:y=H-h-22:format=0:enable='gte(t,2.5)'[vge0];[0:1]aresample=async=1,apad[a] -map [vge0] -map [a] -muxdelay 0 -muxpreload 0 -movflags +faststart -flags +cgop -bf 0 -sc_threshold 0 -codec:v libx264 -profile:v high -preset:v veryfast -codec:a aac -ac 2 -ar 48000 -b:a 192k -b:v 8000k -bufsize:v 16000k -map_metadata -1 -f mpegts -mpegts_flags +initial_discontinuity pipe:1
