---
source: crates/ersatzrs-ffmpeg/tests/pipeline_snapshots.rs
expression: "command.arguments.join(\" \")"
---
-nostdin -hide_banner -nostats -progress pipe:1 -loglevel error -fflags +genpts+discardcorrupt+igndts -c:v h264 -i /media/movie.mkv -filter_complex [0:0]framerate=fps=60/1:flags=-scd[v];[0:1]aresample=async=1,apad[a] -map [v] -map [a] -muxdelay 0 -muxpreload 0 -movflags +faststart -flags +cgop -bf 0 -sc_threshold 0 -codec:v libx264 -profile:v high -preset:v veryfast -codec:a aac -ac 2 -ar 48000 -b:a 192k -b:v 8000k -bufsize:v 16000k -map_metadata -1 -f mpegts -mpegts_flags +initial_discontinuity pipe:1
