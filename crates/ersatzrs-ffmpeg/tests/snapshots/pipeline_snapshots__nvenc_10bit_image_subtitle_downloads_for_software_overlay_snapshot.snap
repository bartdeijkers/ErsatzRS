-nostdin -hide_banner -nostats -progress pipe:1 -loglevel error -fflags +genpts+discardcorrupt+igndts -init_hw_device cuda=nv:0 -filter_hw_device nv -hwaccel cuda -hwaccel_output_format cuda -i /media/movie.mkv -i /media/subtitle.sup -filter_complex [0:0]hwupload,scale_cuda=format=p010le,hwdownload,format=p010le[v];[1:0]scale=1920:1080:force_original_aspect_ratio=decrease,pad=w=1920:h=1080:x=-1:y=-1:color=black@0[st];[v][st]overlay=x=(W-w)/2:y=(H-h)/2:format=1[vst];[vst]setparams=range=tv:colorspace=bt709:color_trc=bt709:color_primaries=bt709[vpf];[0:1]aresample=async=1,apad[a] -map [vpf] -map [a] -muxdelay 0 -muxpreload 0 -movflags +faststart -flags cgop -bf 0 -noautoscale -sc_threshold 0 -codec:v hevc_nvenc -tag:v hvc1 -b_ref_mode 0 -preset:v veryfast -codec:a aac -b:a 192k -maxrate:a 192k -bufsize:a 384k -ar 48k -r 30000/1001 -fps_mode:v cfr -video_track_timescale 90000 -b:v 8000k -maxrate:v 8000k -bufsize:v 16000k -muxrate 9830400 -pcr_period 20 -map_metadata -1 -f mpegts -mpegts_flags +initial_discontinuity pipe:1
