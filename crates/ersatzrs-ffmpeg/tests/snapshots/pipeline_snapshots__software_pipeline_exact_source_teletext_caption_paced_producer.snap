---
source: crates/ersatzrs-ffmpeg/tests/pipeline_snapshots.rs
expression: "paced.join(\" \")"
---
-nostdin -hide_banner -nostats -progress pipe:1 -loglevel error -fflags +genpts+discardcorrupt+igndts -c:v h264 -readrate 1.05 -txt_page:2 888 -txt_format:2 bitmap -txt_default_region:2 -1 -i /media/movie.mkv -filter_complex [0:2]scale=1920:1080:force_original_aspect_ratio=decrease,pad=w=1920:h=1080:x=-1:y=-1:color=black@0[st];[0:0][st]overlay=x=(W-w)/2:y=(H-h)/2:format=0[vst];[vst]setparams=range=tv:colorspace=bt709:color_trc=bt709:color_primaries=bt709[vpf];[0:1]aresample=async=1,apad[a] -map [vpf] -map [a] -muxdelay 0 -muxpreload 0 -movflags +faststart -flags cgop -bf 0 -sc_threshold 0 -codec:v libx264 -profile:v high -preset:v veryfast -codec:a aac -b:a 192k -maxrate:a 192k -bufsize:a 384k -ar 48k -r 30000/1001 -fps_mode:v cfr -video_track_timescale 90000 -b:v 8000k -maxrate:v 8000k -bufsize:v 16000k -muxrate 9830400 -pcr_period 20 -map_metadata -1 -f mpegts -mpegts_flags +initial_discontinuity pipe:1
