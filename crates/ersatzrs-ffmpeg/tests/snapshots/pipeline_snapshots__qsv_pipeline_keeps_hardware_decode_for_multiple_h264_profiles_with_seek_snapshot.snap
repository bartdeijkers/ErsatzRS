env=[EnvironmentVariable { name: "CUDA_VISIBLE_DEVICES", value: "999" }]
args=-nostdin -hide_banner -nostats -progress pipe:1 -loglevel error -fflags +genpts+discardcorrupt+igndts -hwaccel qsv -hwaccel_output_format qsv -init_hw_device qsv=hw -filter_hw_device hw -c:v h264_qsv -ss 12 -i /media/movie.mkv -i /media/movie.mkv -filter_complex [0:0]vpp_qsv=format=nv12,hwdownload,format=nv12,setpts=PTS-STARTPTS,fps=30000/1001[v];[v]setparams=range=tv:colorspace=bt709:color_trc=bt709:color_primaries=bt709[vpf];[1:1]aresample=async=1,apad[a] -map [vpf] -map [a] -muxdelay 0 -muxpreload 0 -movflags +faststart -flags cgop -bf 0 -sc_threshold 0 -codec:v h264_qsv -profile:v high -low_power 0 -look_ahead 0 -preset:v veryfast -codec:a aac -b:a 192k -maxrate:a 192k -bufsize:a 384k -ar 48k -video_track_timescale 90000 -b:v 8000k -maxrate:v 8000k -bufsize:v 16000k -map_metadata -1 -f mpegts -mpegts_flags +initial_discontinuity pipe:1
