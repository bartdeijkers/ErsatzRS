---
source: crates/ersatzrs-ffmpeg/tests/pipeline_snapshots.rs
expression: "command.arguments.join(\" \")"
---
-nostdin -hide_banner -nostats -progress pipe:1 -loglevel error -fflags +genpts+discardcorrupt+igndts -c:v h264 -i /media/movie.mkv -filter_complex [0:1]aresample=async=1,apad[a] -map 0:0 -map [a] -muxdelay 0 -muxpreload 0 -movflags +faststart -flags cgop -bf 0 -sc_threshold 0 -codec:v libx264 -profile:v high -preset:v veryfast -codec:a aac -b:a 192k -bufsize:a 384k -ar 48k -b:v 8000k -bufsize:v 16000k -map_metadata -1 -metadata service_provider="ErsatzTV" -metadata service_name="Cinema One" -metadata:s:a:0 language=eng -metadata:s:s:0 language=nld -metadata:s:s:0 title=Dutch SDH -f mpegts -mpegts_flags +initial_discontinuity pipe:1
