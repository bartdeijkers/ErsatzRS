---
source: crates/ersatzrs-ffmpeg/tests/pipeline_snapshots.rs
expression: "command.arguments.join(\" \")"
---
-nostdin -hide_banner -nostats -progress pipe:1 -loglevel error -fflags +genpts+discardcorrupt+igndts -c:v h264 -i /media/movie.mkv -f lavfi -i color=c=black@0.0:s=1920x1080,format=rgba,subtitles=/tmp/ErsatzRS/subtitle.ass:fontsdir=/tmp/ErsatzRS/fonts:alpha=1 -filter_complex [0:0][1:0]overlay=x=(W-w)/2:y=(H-h)/2:format=0[vge0];[0:1]aresample=async=1,apad[a] -map [vge0] -map [a] -muxdelay 0 -muxpreload 0 -movflags +faststart -flags cgop -bf 0 -sc_threshold 0 -codec:v libx264 -profile:v high -preset:v veryfast -codec:a aac -b:a 192k -maxrate:a 192k -bufsize:a 384k -ar 48k -video_track_timescale 90000 -b:v 8000k -maxrate:v 8000k -bufsize:v 16000k -map_metadata -1 -f mpegts -mpegts_flags +initial_discontinuity pipe:1
