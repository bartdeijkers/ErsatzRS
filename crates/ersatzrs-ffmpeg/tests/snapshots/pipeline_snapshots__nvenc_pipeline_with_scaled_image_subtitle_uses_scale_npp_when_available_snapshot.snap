---
source: crates/ersatzrs-ffmpeg/tests/pipeline_snapshots.rs
expression: "command.arguments.join(\" \")"
---
-nostdin -hide_banner -nostats -progress pipe:1 -loglevel error -fflags +genpts+discardcorrupt+igndts -init_hw_device cuda -hwaccel cuda -hwaccel_output_format cuda -i /media/movie.mkv -i /media/subtitle.sup -filter_complex [0:0]hwupload,scale_cuda=1920:1080:format=nv12,setsar=1,hwdownload,format=nv12,framerate=fps=30000/1001:flags=-scd[v];[1:0]format=yuva420p,hwupload_cuda,scale_npp=1920:1080:force_original_aspect_ratio=1[st];[v][st]overlay_cuda=x=(W-w)/2:y=(H-h)/2[vst];[0:1]aresample=async=1,apad[a] -map [vst] -map [a] -muxdelay 0 -muxpreload 0 -movflags +faststart -flags cgop -bf 0 -noautoscale -sc_threshold 0 -codec:v h264_nvenc -profile:v high -preset:v veryfast -pix_fmt yuv420p -codec:a aac -ar 48k -b:a 192k -b:v 8000k -bufsize:v 16000k -map_metadata -1 -f mpegts -mpegts_flags +initial_discontinuity pipe:1
