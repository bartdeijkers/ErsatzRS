---
source: crates/ersatzrs-ffmpeg/tests/pipeline_snapshots.rs
expression: "format!(\"env={:?}\\nargs={}\", command.environment, command.arguments.join(\" \"))"
---
env=[EnvironmentVariable { name: "LIBVA_DRIVER_NAME", value: "radeonsi" }]
args=-nostdin -hide_banner -nostats -progress pipe:1 -loglevel error -fflags +genpts+discardcorrupt+igndts -init_hw_device vaapi -hwaccel vaapi -hwaccel_output_format vaapi -i /media/movie.mkv -i /media/movie.mkv -i /media/subtitle.sup -filter_complex [0:0]scale_vaapi=format=nv12,hwdownload,format=nv12[v];[2:0]scale=1920:1080:force_original_aspect_ratio=decrease,pad=w=1920:h=1080:x=-1:y=-1:color=black@0[st];[v][st]overlay=x=(W-w)/2:y=(H-h)/2:format=0[vst];[1:1]aresample=async=1,apad[a] -map [vst] -map [a] -muxdelay 0 -muxpreload 0 -movflags +faststart -flags cgop -bf 0 -noautoscale -sc_threshold 0 -codec:v h264_vaapi -profile:v high -codec:a aac -ar 48k -b:a 192k -b:v 8000k -bufsize:v 16000k -map_metadata -1 -f mpegts -mpegts_flags +initial_discontinuity pipe:1
