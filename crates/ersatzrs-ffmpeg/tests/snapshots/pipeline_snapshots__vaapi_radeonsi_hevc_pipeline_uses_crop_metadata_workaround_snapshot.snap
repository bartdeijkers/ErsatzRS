---
source: crates/ersatzrs-ffmpeg/tests/pipeline_snapshots.rs
expression: "format!(\"env={:?}\\nargs={}\", command.environment, command.arguments.join(\" \"))"
---
env=[EnvironmentVariable { name: "LIBVA_DRIVER_NAME", value: "radeonsi" }]
args=-nostdin -hide_banner -nostats -progress pipe:1 -loglevel error -fflags +genpts+discardcorrupt+igndts -vaapi_device /dev/dri/renderD128 -hwaccel vaapi -hwaccel_output_format vaapi -readrate 1.05 -i /media/movie.mkv -readrate 1.05 -i /media/movie.mkv -filter_complex [0:0]scale_vaapi=format=nv12[v];[1:1]aresample=async=1,apad[a] -map [v] -map [a] -muxdelay 0 -muxpreload 0 -movflags +faststart -flags cgop -bf 0 -noautoscale -sc_threshold 0 -codec:v hevc_vaapi -pix_fmt yuv420p -codec:a aac -video_track_timescale 90000 -bsf:v hevc_metadata=crop_bottom=8 -map_metadata -1 -f mpegts -mpegts_flags +initial_discontinuity pipe:1
