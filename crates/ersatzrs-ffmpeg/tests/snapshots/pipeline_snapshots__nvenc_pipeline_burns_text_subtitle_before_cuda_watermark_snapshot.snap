---
source: crates/ersatzrs-ffmpeg/tests/pipeline_snapshots.rs
assertion_line: 2021
expression: "command.arguments.join(\" \")"
---
-nostdin -hide_banner -nostats -progress pipe:1 -loglevel error -fflags +genpts+discardcorrupt+igndts -init_hw_device cuda=nv:0 -filter_hw_device nv -hwaccel cuda -hwaccel_output_format cuda -i /media/movie.mkv -stream_loop -1 -i /media/logo.png -filter_complex [0:0]hwupload,scale_cuda=format=nv12,hwdownload,format=nv12,subtitles=/cache/streams/subtitles/AA/BB/subtitle.srt:fontsdir=/cache/streams/fonts[v];[1:0]setpts=PTS-STARTPTS,scale=240:-1,format=yuva420p|yuva444p|yuva422p|rgba|abgr|bgra|gbrap|ya8,colorchannelmixer=aa=0.75[wm0];[v][wm0]overlay=x=W-w-38:y=32:format=0:shortest=1[vwm0];[vwm0]setparams=range=tv:colorspace=bt709:color_trc=bt709:color_primaries=bt709[vpf];[0:1]aresample=async=1,apad[a] -map [vpf] -map [a] -muxdelay 0 -muxpreload 0 -movflags +faststart -flags cgop -bf 0 -noautoscale -sc_threshold 0 -codec:v h264_nvenc -profile:v high -preset:v veryfast -codec:a aac -b:a 192k -maxrate:a 192k -bufsize:a 384k -ar 48k -r 30000/1001 -fps_mode:v cfr -video_track_timescale 90000 -b:v 8000k -maxrate:v 8000k -bufsize:v 16000k -muxrate 9830400 -pcr_period 20 -map_metadata -1 -f mpegts -mpegts_flags +initial_discontinuity pipe:1
