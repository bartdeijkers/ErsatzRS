---
source: crates/ersatzrs-ffmpeg/tests/pipeline_snapshots.rs
expression: "command.arguments.join(\" \")"
---
-nostdin -hide_banner -nostats -progress pipe:1 -loglevel error -fflags +genpts+discardcorrupt+igndts -init_hw_device cuda -hwaccel cuda -hwaccel_output_format cuda -i /media/movie.mkv -loop 1 -i /media/logo.png -filter_complex [0:0]hwupload,scale_cuda=format=nv12[v];[1:0]scale=240:-1,format=yuva420p|yuva444p|yuva422p|rgba|abgr|bgra|gbrap|ya8,colorchannelmixer=aa=0.75,format=yuva420p,hwupload_cuda[wm0];[v][wm0]overlay_cuda=x=W-w-38:y=32[vwm0];[0:1]aresample=async=1,apad[a] -map [vwm0] -map [a] -muxdelay 0 -muxpreload 0 -movflags +faststart -flags cgop -bf 0 -noautoscale -sc_threshold 0 -codec:v h264_nvenc -profile:v high -preset:v veryfast -pix_fmt yuv420p -codec:a aac -b:a 192k -maxrate:a 192k -bufsize:a 384k -ar 48k -video_track_timescale 90000 -b:v 8000k -maxrate:v 8000k -bufsize:v 16000k -map_metadata -1 -f mpegts -mpegts_flags +initial_discontinuity pipe:1
