2143ms
-noautorotate
-i
SOURCE
-filter_complex
[0:3]aresample=async=1,apad[a]
-filter_complex
[0:0]setpts=PTS+round(2.143/TB),subtitles=SIDECAR:fontsdir=FONTS,setpts=PTS-round(2.143/TB)[v]
-map
[v]
-map
[a]
-muxdelay
0
-muxpreload
0
-movflags
+faststart
-noautoscale
-acodec
aac
-b:a
128k
-maxrate:a
128k
-bufsize:a
256k
-ar
48000
-vcodec
libx264
-b:v
4000k
-maxrate:v
4000k
-bufsize:v
2000k
-map_metadata
-1
-t
7057ms
-shortest
-video_track_timescale
90000
-map_metadata:s:a:0
0:s:3
-g
50
-keyint_min
50
-force_key_frames
expr:gte(t,n_forced*2)
